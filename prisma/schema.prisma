// Presumptuous Learning — data model (Phase 1)
// Every school is its own tenant: its people, classes, timetable, calendar and records
// are keyed by schoolId and never shown to another school.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN // Presumptuous Learning staff: creates schools
  SCHOOL_ADMIN // principal / office: runs one school
  COACH
  PARENT
  STUDENT
}

enum BlockKind {
  ASSEMBLY
  ACADEMICS
  BREAK
  ARTS
  LUNCH
  LIFE_SKILLS
  REFLECTION
  OTHER
}

enum CalendarKind {
  FIRST_DAY
  LAST_DAY
  HOLIDAY
  BREAK
  PA_DAY
  REPORT
  EVENT
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETE
}

model School {
  id         String   @id @default(cuid())
  name       String
  code       String   @unique // short code students type when signing in
  timezone   String   @default("America/Toronto")
  coachTitle String   @default("Coach")
  yearStart  DateTime @db.Date
  yearEnd    DateTime @db.Date
  isDemo     Boolean  @default(false)
  aiTutor    Boolean  @default(false) // school has opted in to AI explanations for students
  launchDay  DateTime? @db.Date // Launch Day for student projects (May)
  aiNeedsConsent Boolean @default(true) // AI features that send a student's own writing need a parent's AI consent first
  createdAt  DateTime @default(now())

  users      User[]
  classes    Class[]
  blocks     ScheduleBlock[]
  events     CalendarEvent[]
  attendance Attendance[]
}

model User {
  id           String   @id @default(cuid())
  role         Role
  schoolId     String?
  school       School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email        String?  @unique // adults sign in with email
  username     String? // students sign in with school code + username
  passwordHash String
  firstName    String
  lastName     String
  grade        Int? // students only: 0 = Kindergarten … 12
  familyCode   String?  @unique // students only: parents use it to link
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  sessions        Session[]
  coachOf         ClassCoach[]
  studentIn       ClassStudent[]
  children        ParentLink[]   @relation("ParentToLink")
  parents         ParentLink[]   @relation("StudentToLink")
  assessments     Assessment[]
  practice        PracticeSession[]
  skills          SkillProgress[]
  dailyLogs       DailyLog[]
  assignmentsMade Assignment[]       @relation("AssignmentCreator")
  assignedWork    AssignmentTarget[] @relation("AssignmentStudent")
  notesAbout      CoachNote[]        @relation("NoteAbout")
  notesWritten    CoachNote[]        @relation("NoteAuthor")
  artworks        Artwork[]          @relation("ArtworkStudent")
  artFeedback     ArtFeedback[]      @relation("FeedbackAuthor")
  projects        Project[]          @relation("ProjectStudent")
  consents        Consent[]          @relation("ConsentStudent")
  attendance      Attendance[]   @relation("AttendanceStudent")
  markedAttendance Attendance[]  @relation("AttendanceMarker")

  @@unique([schoolId, username])
  @@index([schoolId, role])
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Class {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  grades    Int[]
  createdAt DateTime @default(now())

  coaches  ClassCoach[]
  students ClassStudent[]

  @@index([schoolId])
}

model ClassCoach {
  classId String
  coachId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  coach   User   @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([classId, coachId])
}

model ClassStudent {
  classId   String
  studentId String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
}

model ParentLink {
  parentId  String
  studentId String
  parent    User     @relation("ParentToLink", fields: [parentId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentToLink", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([parentId, studentId])
}

model ScheduleBlock {
  id       String    @id @default(cuid())
  schoolId String
  school   School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  position Int
  start    String // "09:00"
  end      String // "09:30"
  title    String
  kind     BlockKind
  focus    String    @default("")

  @@index([schoolId, position])
}

model CalendarEvent {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  kind      CalendarKind
  title     String
  startDate DateTime     @db.Date
  endDate   DateTime     @db.Date
  noSchool  Boolean      @default(false)

  @@index([schoolId, startDate])
}

model Attendance {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId  String
  student    User             @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus
  note       String           @default("")
  markedById String?
  markedBy   User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  updatedAt  DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([schoolId, date])
}

model Assessment {
  id          String           @id @default(cuid())
  studentId   String
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade       Int
  subjects    String[]
  status      AssessmentStatus @default(IN_PROGRESS)
  mode        String           @default("fixed") // "fixed" (Phase 1) or "adaptive"
  questions   Json // [{sid, tier, p, i, order}]
  answers     Json // (number | null)[]  original option index, -1 = not sure
  results     Json? // per-subject placement, written on completion
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  @@index([studentId, status])
}

// ---------------- Phase 2: question bank and practice ----------------

/// The question bank. Built-in questions are seeded from src/lib/bank.ts (key "lang-5-0");
/// questions added in the editor get key "custom-<id>". Generated math questions are not stored.
model Question {
  id          String   @id @default(cuid())
  key         String   @unique
  subject     String
  grade       Int // 0 = Kindergarten … 12, 13 = beyond Grade 12
  strand      String
  skill       String
  prompt      String
  correct     String
  wrong1      String
  wrong2      String
  wrong3      String
  explanation String   @default("")
  active      Boolean  @default(true)
  reviewed    Boolean  @default(false) // checked by a certified teacher
  source      String   @default("builtin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subject, grade, active])
}

model PracticeSession {
  id          String    @id @default(cuid())
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject     String
  grade       Int // grade level the set was drawn from
  skill       String    @default("")
  kind        String    @default("practice") // "practice" or "mastery" (the check after a lesson)
  lessonId    String?
  questions   Json // StoredQuestion[]
  answers     Json // (number | null)[]
  correct     Int       @default(0)
  total       Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([studentId, startedAt])
}

/// Cached AI tutor explanations, one per question + wrong answer. No student data is stored or sent.
model TutorExplanation {
  key       String   @id // "<question id>:<chosen choice index>"
  text      String
  model     String
  createdAt DateTime @default(now())
}

/// One row per explanation a student asked for (daily limit).
model TutorRequest {
  id        String   @id @default(cuid())
  studentId String
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

// ---------------- Phase 2: lessons and mastery ----------------

/// A short lesson for one skill at one grade. variant 1 = first teaching, 2 and 3 = reteach in a different way.
/// Generated once by AI and shared by every student; the platform admin can review or retire it.
model Lesson {
  id        String   @id @default(cuid())
  subject   String
  grade     Int
  skill     String
  variant   Int      @default(1)
  content   Json // LessonContent
  model     String   @default("")
  reviewed  Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subject, grade, skill, variant])
}

enum SkillState {
  LEARNING
  MASTERED
}

/// Where a student is with one skill: lessons seen, mastery checks taken, mastered or not.
model SkillProgress {
  id         String     @id @default(cuid())
  studentId  String
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject    String
  grade      Int
  skill      String
  state      SkillState @default(LEARNING)
  attempts   Int        @default(0) // mastery checks taken
  lastScore  Int        @default(0)
  lastTotal  Int        @default(0)
  masteredAt DateTime?
  updatedAt  DateTime   @updatedAt

  @@unique([studentId, subject, grade, skill])
  @@index([studentId, state])
}

// ---------------- Phase 3: the school day ----------------

/// One row per student per school day: morning check-in and end-of-day reflection.
model DailyLog {
  id           String    @id @default(cuid())
  studentId    String
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  mood         Int? // 1 = rough … 5 = great
  goal         String    @default("")
  checkedInAt  DateTime?
  learned      String    @default("")
  question     String    @default("")
  effort       Int? // 1 = took it easy … 4 = overreached
  reflectedAt  DateTime?
  artsDone     Boolean   @default(false)
  lifeDone     Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  @@unique([studentId, date])
}

// ---------------- Phase 4: coach tools ----------------

enum AssignmentKind {
  MASTER_SKILL // learn the lesson and pass the mastery check
  PRACTICE // finish a practice set on the skill
  ASSESSMENT // retake the placement assessment
}

model Assignment {
  id          String             @id @default(cuid())
  schoolId    String
  createdById String
  createdBy   User               @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  kind        AssignmentKind
  subject     String             @default("")
  grade       Int                @default(0)
  skill       String             @default("")
  note        String             @default("")
  dueDate     DateTime?          @db.Date
  createdAt   DateTime           @default(now())
  targets     AssignmentTarget[]

  @@index([schoolId, createdAt])
}

model AssignmentTarget {
  assignmentId String
  studentId    String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, studentId])
  @@index([studentId])
}

model CoachNote {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("NoteAbout", fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  shared    Boolean  @default(false) // visible to the student and their family
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
}

// ---------------- Phase 5: studio and portfolio ----------------

enum Discipline {
  VISUAL_ARTS
  MUSIC
  DRAMA
  DANCE
  MEDIA_ARTS
  WRITING
}

/// A piece of student work in their portfolio.
model Artwork {
  id         String        @id @default(cuid())
  schoolId   String
  studentId  String
  student    User          @relation("ArtworkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  discipline Discipline
  title      String
  reflection String        @default("") // what I tried / what I'd change
  prompt     String        @default("") // the prompt it answered, if any
  textBody   String        @default("") // a poem, script or story
  fileId     String?       @unique
  file       ArtFile?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  featured   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  feedback   ArtFeedback[]

  @@index([studentId, createdAt])
  @@index([schoolId, createdAt])
}

/// Uploaded media for an artwork, stored in the database (pilot scale; move to object storage later).
model ArtFile {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  artwork   Artwork?
}

model ArtFeedback {
  id        String   @id @default(cuid())
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([artworkId])
}

// ---------------- Phase 6: Life Skills and Purpose projects ----------------

enum ProjectType {
  LIFE_SKILLS // a business the student launches
  PURPOSE // a community impact or give-back project
}

enum MilestoneStatus {
  TODO
  SUBMITTED
  NEEDS_WORK
  APPROVED
}

model Project {
  id         String             @id @default(cuid())
  schoolId   String
  studentId  String
  student    User               @relation("ProjectStudent", fields: [studentId], references: [id], onDelete: Cascade)
  type       ProjectType
  schoolYear Int // the September it started
  interview  Json? // the student's discovery answers
  ideas      Json? // AI-suggested ideas
  title      String             @default("")
  oneLiner   String             @default("")
  problem    String             @default("")
  audience   String             @default("")
  plan       String             @default("")
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  milestones ProjectMilestone[]

  @@unique([studentId, type, schoolYear])
  @@index([schoolId])
}

model ProjectMilestone {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position     Int
  key          String
  title        String
  description  String
  dueDate      DateTime        @db.Date
  status       MilestoneStatus @default(TODO)
  evidence     String          @default("")
  link         String          @default("")
  feedback     String          @default("")
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?

  @@index([projectId, position])
}

// ---------------- Phase 7: privacy, consent and audit ----------------

/// Who did what to whose records. Kept when a student is deleted (studentId stays as a plain id).
model AuditEvent {
  id        String   @id @default(cuid())
  schoolId  String?
  actorId   String?
  actorName String   @default("")
  actorRole String   @default("")
  action    String // e.g. "student.view", "student.export", "student.delete", "password.reset"
  studentId String?
  detail    String   @default("")
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([studentId, createdAt])
}

enum ConsentKind {
  PLATFORM // use of the platform and storing the child's learning records
  AI // AI features that send the child's own writing or answers to the AI service
}

/// The latest consent decision per student and kind. givenBy = parent's user id, or "school" when recorded from paper.
model Consent {
  id        String      @id @default(cuid())
  studentId String
  student   User        @relation("ConsentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  kind      ConsentKind
  granted   Boolean
  givenBy   String
  byName    String
  updatedAt DateTime    @updatedAt

  @@unique([studentId, kind])
}

model DeletionRequest {
  id          String    @id @default(cuid())
  schoolId    String
  studentId   String
  requestedBy String
  byName      String
  reason      String    @default("")
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  outcome     String    @default("") // "deleted" or "declined"

  @@index([schoolId, resolvedAt])
}
