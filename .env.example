# LOCAL DEVELOPMENT ONLY. Copy to .env on your own computer.
# On Railway, do NOT copy these values. Set DATABASE_URL to the reference
#   ${{Postgres.DATABASE_URL}}
# and set your own ADMIN_EMAIL / ADMIN_PASSWORD (see README).

DATABASE_URL="postgresql://postgres@localhost:5432/pl_dev?host=/tmp"

# First platform admin account, created on startup if no platform admin exists yet.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_FIRST_NAME="Andrew"
ADMIN_LAST_NAME="James"

# Optional: shown on invoices (Phase 8)
# BILLING_NAME="Presumptuous Learning Inc."
# HST_NUMBER="123456789 RT0001"
